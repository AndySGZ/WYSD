<mujoco model="underwater_sampling_l4">
  <!-- L4 易碎珊瑚轻取
       难度轴：**接触力约束**。珊瑚能夹起来，但夹持力超过阈值即判"夹碎"（失败）——
               逼出"轻合爪、够用就停"的操作，而不是一夹到底。

       珊瑚是 3x3x4cm 的柱状碎块（珊瑚分枝的简化）：比 L1/L2 的 4cm 方岩更窄，
       夹持窗口更小。注意 x/y 尺寸必须相等（夹爪沿 y 合拢，env 用 geom_size[0] 标定宽度）。 -->
  <include file="_base.xml"/>

  <worldbody>
    <body name="object" pos="1.60 0.06 0.37">
      <freejoint name="object_joint"/>
      <geom name="object_geom" type="box" size="0.015 0.015 0.02" mass="0.05"
            solref="0.002 1" rgba="0.82 0.45 0.40 1" friction="0.7 0.02 0.001"/>
    </body>

    <!-- 托盘几何与 L1 一致（内净 12cm、三面壁 2.5cm、近侧开口），另加一层软垫：易碎品要"轻放"，
         垫子也顺带把落体的冲击吃掉。静置中心 = 盘底顶面(0.010) + 垫厚(0.008) + 珊瑚半高(0.020)。 -->
    <body name="place_target" pos="1.60 -0.11 0.35">
      <geom name="tray_floor" type="box" size="0.065 0.065 0.005" pos="0 0 0.005"
            solref="0.02 1" rgba="0.50 0.48 0.30 1" friction="0.9 0.02 0.001"/>
      <geom name="tray_wall_xp" type="box" size="0.005 0.07 0.0125" pos="0.0675 0 0.0225"
            rgba="0.44 0.42 0.27 1" friction="0.9 0.02 0.001"/>
            rgba="0.44 0.42 0.27 1" friction="0.9 0.02 0.001"/>
      <geom name="tray_wall_yp" type="box" size="0.065 0.005 0.0125" pos="0 0.0675 0.0225"
            rgba="0.44 0.42 0.27 1" friction="0.9 0.02 0.001"/>
      <geom name="tray_wall_yn" type="box" size="0.065 0.005 0.0125" pos="0 -0.0675 0.0225"
            rgba="0.44 0.42 0.27 1" friction="0.9 0.02 0.001"/>
      <geom name="tray_pad" type="box" size="0.06 0.06 0.004" pos="0 0 0.014"
            solref="0.04 1" rgba="0.30 0.34 0.28 1" friction="0.9 0.02 0.001"/>
      <site name="place_target_site" pos="0 0 0.038" size="0.01"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="home" qpos="0.0374 -0.5858 -1.4717 0.3109 -0.1223 -1.5642 0.22 0.22 1.60 0.06 0.37 1 0 0 0"
         ctrl="0.0374 -0.5858 -1.4717 0.3109 -0.1223 -1.5642 0.22 0.22"/>
  </keyframe>
</mujoco>
