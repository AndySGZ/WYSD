<mujoco model="uranus_reach">
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <worldbody>
    <!-- 地面：下移 5cm，避免 Uranus 底座/连杆几何体(z 延伸到 -0.02~-0.004)穿入地面 -->
    <geom name="floor" type="plane" size="4 4 0.05" pos="0 0 -0.05" rgba="0.80 0.82 0.86 1"/>
    <light pos="3 3 4" dir="-3 -3 -4" diffuse="0.75 0.75 0.75"/>

    <!-- 目标块：大臂点对点到达任务的目标点（视觉标记，不参与碰撞） -->
    <body name="target" pos="1.5 0.3 0.25">
      <geom name="target_geom" type="sphere" size="0.08" rgba="0.90 0.22 0.22 1" contype="0" conaffinity="0"/>
      <site name="target_site" size="0.01"/>
    </body>
  </worldbody>

  <!-- Uranus 机械臂 -->
  <include file="uranus/uranus_arm_gripper_model.xml"/>

  <keyframe>
    <key name="home" qpos="0 -0.812224 -1.485888 0.726678 0 0 0 0"
         ctrl="0 -0.812224 -1.485888 0.726678 0 0 0 0"/>
  </keyframe>
</mujoco>
