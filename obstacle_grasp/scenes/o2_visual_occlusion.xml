<mujoco model="obstacle_grasp_o2">
  <!-- O2 视觉遮挡（相机与目标之间的立板）
       难度轴：**看得见但看不清** —— 立板挡在 grasp_cam 与目标之间，目标的可见部分被切掉；
       而抓取路径仍然通畅（立板在 y 侧，不在钳口走廊里）。
       另放一个会动的干扰块：撞位移 >1cm 即判失败，逼出"绕着走"。

       立板高度是算过的：相机(1.60,-1.0,1.0) 看目标(1.60,0.06,0.37) 的视线，
       在 y=-0.03 处高度是 0.424m，立板顶 0.46m > 0.424 -> 真的挡住了。 -->
  <include file="_base.xml"/>

  <worldbody>
    <body name="object" pos="1.60 0.06 0.37">
      <freejoint name="object_joint"/>
      <geom name="object_geom" type="box" size="0.02 0.02 0.02" mass="0.1"
            solref="0.002 1" rgba="0.95 0.75 0.2 1" friction="0.6 0.02 0.001"/>
    </body>

    <!-- 遮挡立板（静态工装，位置随目标一起随机化 -> 遮挡关系始终成立）。
         高度是量出来的：最初写半高 55mm（顶 0.46m），实测把目标**100% 全挡**（藏掉目标
         一个像素都不变）—— 那就成了盲抓，不是"部分遮挡"。
         视线从相机(1.60,-1.0,1.0)掠立板顶继续下落到目标处的斜率是 -0.577/单位 y，
         立板在目标前方 9cm -> 掠顶线在目标处的高度 = 顶高 - 0.052。
         取顶高 0.422m -> 掠顶线落在目标高度 0.37（目标 z 0.35~0.39 的正中）-> 约 50% 被挡。 -->
    <body name="occluder" pos="1.60 -0.03 0.386">
      <geom name="occluder_geom" type="box" size="0.045 0.006 0.036" mass="0.4"
            rgba="0.35 0.38 0.44 1" friction="0.6 0.02 0.001"/>
    </body>

    <!-- 动态干扰块：不许碰移位 -->
    <body name="distractor" pos="1.60 0.14 0.365">
      <freejoint name="distractor_joint"/>
      <geom name="distractor_geom" type="box" size="0.015 0.015 0.015" mass="0.05"
            solref="0.002 1" rgba="0.35 0.65 0.45 1" friction="0.6 0.02 0.001"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="home" qpos="0.0374 -0.5858 -1.4717 0.3109 -0.1223 -1.5642 0.22 0.22 1.60 0.06 0.37 1 0 0 0 1.60 0.14 0.365 1 0 0 0"
         ctrl="0.0374 -0.5858 -1.4717 0.3109 -0.1223 -1.5642 0.22 0.22"/>
  </keyframe>
</mujoco>
