<mujoco model="obstacle_grasp_o3">
  <!-- O3 前方低梁（挡腕部通道）
       难度轴：**路径阻挡** —— 低梁在物块的 -x 侧、腕部高度上，正好压住默认抓取走廊。
       Uranus 抓取时腕部(link6_mount) 在齿面中点后约 12.4cm、高约 3cm，半径 3cm：
       默认姿态下腕部要穿过 x≈1.476 一带的 z≈0.37~0.43 空间，而低梁就在 1.533~1.557、
       z 0.398~0.442 -> 撞上。必须**重新定向腕部**（俯仰/偏航）让腕部从梁下或梁侧绕过去。
       这正是"给遥操作加腕部自由度"之后才做得出来的任务。

       低梁由两端立柱支撑（纯视觉合理性），不是悬空的。 -->
  <include file="_base.xml"/>

  <worldbody>
    <body name="object" pos="1.60 0.06 0.37">
      <freejoint name="object_joint"/>
      <geom name="object_geom" type="box" size="0.02 0.02 0.02" mass="0.1"
            solref="0.002 1" rgba="0.95 0.75 0.2 1" friction="0.6 0.02 0.001"/>
    </body>

    <!-- 低梁 + 两端立柱（静态；位置随目标一起随机化） -->
    <body name="overhang" pos="1.545 0.06 0.420">
      <geom name="overhang_beam" type="box" size="0.012 0.055 0.022" mass="0.5"
            rgba="0.38 0.40 0.46 1" friction="0.6 0.02 0.001"/>
      <geom name="overhang_post_yp" type="box" size="0.012 0.010 0.055" pos="0 0.062 -0.025"
            mass="0.3" rgba="0.32 0.34 0.40 1" friction="0.6 0.02 0.001"/>
      <geom name="overhang_post_yn" type="box" size="0.012 0.010 0.055" pos="0 -0.062 -0.025"
            mass="0.3" rgba="0.32 0.34 0.40 1" friction="0.6 0.02 0.001"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="home" qpos="0.0374 -0.5858 -1.4717 0.3109 -0.1223 -1.5642 0.22 0.22 1.60 0.06 0.37 1 0 0 0"
         ctrl="0.0374 -0.5858 -1.4717 0.3109 -0.1223 -1.5642 0.22 0.22"/>
  </keyframe>
</mujoco>
